<?xml version="1.0" encoding="utf-8"?>
<!--
    Ícono adaptativo (API 26+): fondo azul claro de marca +
    logo de OrderBot como foreground. El monochrome permite
    los "íconos temáticos" de Android 13+.
-->
<adaptive-icon xmlns:android="http://schemas.android.com/apk/res/android">
    <background android:drawable="@color/ic_launcher_background" />
    <foreground android:drawable="@drawable/ic_launcher_foreground_logo" />
    <monochrome android:drawable="@drawable/ic_launcher_foreground_logo" />
</adaptive-icon>
